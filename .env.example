# ============================================================================
# .env.example - Plantilla de Variables de Entorno
# ============================================================================
# Este archivo sirve como plantilla para crear el archivo .env real.
# NUNCA se debe subir el archivo .env al repositorio (debe estar en .gitignore).
#
# Instrucciones:
#   1. Copiar este archivo: cp .env.example .env
#   2. Editar .env con los valores reales de tu entorno local.
#
# Estas variables son leídas por python-decouple en settings.py para
# separar la configuración sensible del código fuente (principio 12-Factor).
# ============================================================================

# --------------------------------------------------------------------------
# Configuración de Base de Datos PostgreSQL
# --------------------------------------------------------------------------
# DB_NAME: Nombre de la base de datos en PostgreSQL.
# Debe existir previamente (CREATE DATABASE farmacia_b2b;).
DB_NAME=farmacia_b2b

# DB_USER: Usuario de PostgreSQL con permisos sobre la base de datos.
DB_USER=postgres

# DB_PASSWORD: Contraseña del usuario de PostgreSQL.
# IMPORTANTE: Usar una contraseña segura en producción.
DB_PASSWORD=tu_password_aqui

# DB_HOST: Dirección del servidor PostgreSQL.
# 'localhost' para desarrollo local, IP o dominio para producción.
DB_HOST=localhost

# DB_PORT: Puerto de PostgreSQL (por defecto 5432).
DB_PORT=5432

# --------------------------------------------------------------------------
# Configuración de Django
# --------------------------------------------------------------------------
# SECRET_KEY: Clave secreta usada por Django para firmas criptográficas
# (tokens CSRF, sesiones, hashing de contraseñas).
# NUNCA compartir ni exponer esta clave. Generar una nueva para producción.
# Puedes generar una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-secret-key-super-segura-aqui

# DEBUG: Activa/desactiva el modo debug de Django.
# True = muestra errores detallados (SOLO desarrollo).
# False = oculta errores, muestra páginas 500 genéricas (producción).
DEBUG=True
